[Unit]
Description=Opt-in Weekly Maintenance Window for LAI Upgrades
Documentation=https://blake-olinger.github.io/lai/

[Timer]
# Runs weekly Sunday 03:00 UTC with randomized jitter; no-op unless updates.enabled=true.
OnCalendar=Sun *-*-* 03:00:00 UTC
RandomizedDelaySec=15m
Persistent=true
Unit=lai-upgrade.service

[Install]
WantedBy=timers.target
