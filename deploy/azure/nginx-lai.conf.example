# Production Nginx Reverse Proxy for Local AI Platform (LAI) on Azure Ubuntu VM
# Install at: /etc/nginx/sites-available/lai.conf and symlink into /etc/nginx/sites-enabled/
# Validate with `sudo nginx -t && sudo systemctl reload nginx`.

upstream lai_backend {
    server 127.0.0.1:8400;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ai.corp.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ai.corp.example.com;

    # TLS certificates (managed via Azure Key Vault VM extension, certbot, or corporate PKI)
    ssl_certificate     /etc/ssl/certs/ai.corp.example.com.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/ai.corp.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:LAI_SSL:10m;
    ssl_session_tickets off;

    # Security response headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Tight default limit for JSON API routes; 250M uploads are scoped strictly to /v1/files
    client_max_body_size 2M;
    client_body_timeout  300s;

    location /v1/health {
        proxy_pass http://lai_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }

    location /v1/files {
        client_max_body_size 250M;
        proxy_pass http://lai_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_connect_timeout 30s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
    }

    location / {
        proxy_pass http://lai_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Forward verified client IP and original scheme (pair with LAI trusted_proxy_cidrs)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events (SSE) and long-running LLM generation streaming
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_connect_timeout 30s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
    }
}
